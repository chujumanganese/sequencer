<!-- ============================================================
     TRADE / CHART SCREEN
============================================================ -->

<div class="screen" id="tradeScreen">
    <div class="topbar">
    <div class="back-btn" onclick="go('homeScreen')">
        <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#94a3b8"
        stroke-width="2"
        >
        <polyline points="15 18 9 12 15 6" />
        </svg>
    </div>
    <span class="page-title">Markets</span>
    <div
        style="
        display: flex;
        align-items: center;
        gap: 6px;
        margin-left: auto;
        font-size: 11px;
        color: var(--muted);
        "
    >
        <span
        style="
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #22c55e;
            display: inline-block;
            animation: pulse 1.5s infinite;
        "
        ></span
        >Live
    </div>
    </div>
    <div class="scbody" style="padding: 0">
    <!-- COIN SELECTOR TABS -->
    <div
        id="chartCoinTabs"
        style="
        display: flex;
        gap: 0;
        overflow-x: auto;
        padding: 0 16px 0;
        border-bottom: 1px solid var(--border);
        scrollbar-width: none;
        "
    ></div>

    <!-- PRICE HEADER -->
    <div style="padding: 18px 20px 0">
        <div
        style="
            display: flex;
            align-items: flex-end;
            gap: 12px;
            margin-bottom: 4px;
        "
        >
        <div
            style="
            font-family: &quot;Space Mono&quot;, monospace;
            font-size: 28px;
            font-weight: 700;
            "
            id="chartPrice"
        >
            $97,650.00
        </div>
        <div
            id="chartChangeBadge"
            style="
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 4px;
            background: rgba(34, 197, 94, 0.12);
            color: #22c55e;
            "
        >
            +2.41%
        </div>
        </div>
        <div style="font-size: 12px; color: var(--muted)" id="chartChangeAmt">
        +$2,302.18 today
        </div>
    </div>

    <!-- TIMEFRAME TABS -->
    <div style="display: flex; gap: 4px; padding: 14px 20px 10px">
        <button class="tf-btn on" onclick="setTF(this, '1H')">1H</button>
        <button class="tf-btn" onclick="setTF(this, '4H')">4H</button>
        <button class="tf-btn" onclick="setTF(this, '1D')">1D</button>
        <button class="tf-btn" onclick="setTF(this, '1W')">1W</button>
        <button class="tf-btn" onclick="setTF(this, '1M')">1M</button>
    </div>

    <!-- CHART CANVAS -->
    <div style="padding: 0 20px; position: relative">
        <canvas
        id="priceChart"
        style="width: 100%; height: 220px; display: block"
        ></canvas>
    </div>

    <!-- STATS ROW -->
    <div
        style="
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        margin-top: 12px;
        "
    >
        <div
        style="
            padding: 14px 0 14px 16px;
            border-right: 1px solid var(--border);
        "
        >
        <div
            style="
            font-size: 10px;
            color: var(--muted);
            margin-bottom: 4px;
            font-weight: 500;
            "
        >
            OPEN
        </div>
        <div
            style="
            font-size: 13px;
            font-weight: 700;
            font-family: &quot;Space Mono&quot;, monospace;
            "
            id="statOpen"
        >
            95,348
        </div>
        </div>
        <div
        style="padding: 14px 12px; border-right: 1px solid var(--border)"
        >
        <div
            style="
            font-size: 10px;
            color: var(--muted);
            margin-bottom: 4px;
            font-weight: 500;
            "
        >
            HIGH
        </div>
        <div
            style="
            font-size: 13px;
            font-weight: 700;
            font-family: &quot;Space Mono&quot;, monospace;
            color: #22c55e;
            "
            id="statHigh"
        >
            98,200
        </div>
        </div>
        <div
        style="padding: 14px 12px; border-right: 1px solid var(--border)"
        >
        <div
            style="
            font-size: 10px;
            color: var(--muted);
            margin-bottom: 4px;
            font-weight: 500;
            "
        >
            LOW
        </div>
        <div
            style="
            font-size: 13px;
            font-weight: 700;
            font-family: &quot;Space Mono&quot;, monospace;
            color: #ef4444;
            "
            id="statLow"
        >
            94,810
        </div>
        </div>
        <div style="padding: 14px 12px">
        <div
            style="
            font-size: 10px;
            color: var(--muted);
            margin-bottom: 4px;
            font-weight: 500;
            "
        >
            VOL
        </div>
        <div
            style="
            font-size: 13px;
            font-weight: 700;
            font-family: &quot;Space Mono&quot;, monospace;
            "
            id="statVol"
        >
            28.4B
        </div>
        </div>
    </div>

    <!-- COIN LIST WITH SPARKLINES -->
    <div style="padding: 16px 20px 0">
        <div style="font-size: 14px; font-weight: 600; margin-bottom: 12px">
        All Markets
        </div>
        <div
        id="marketList"
        style="
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding-bottom: 24px;
        "
        ></div>
    </div>
    </div>
</div>