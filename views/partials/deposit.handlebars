<!-- ============================================================
                    DEPOSIT SCREEN
============================================================ -->
<link rel="stylesheet" href="/css/deposit.css">
<div class="screen" x-data="{phase: 1}">

    <div class="topbar">
        <span class="page-title">Select coin</span>
    </div><br>

    <div class="stepbar active">
        <div class="stp idle" id="ds1">
            <span class="snum" :class="phase === 1 ? 'selected_one' : 'snum'">1</span>
            <span class="slbl">Coin</span>
        </div>

        <div class="sline" id="dl1"></div>

        <div class="stp idle" id="ds2">
            <span class="snum" :class="phase === 2 ? 'selected_one' : 'snum'">2</span>
            <span class="slbl">Network</span>
        </div>

        <div class="sline" id="dl2"></div>

        <div class="stp idle" id="ds3">
            <span class="snum" :class="phase === 3 ? 'selected_one' : 'snum'">3</span>
            <span class="slbl">Address</span>
        </div>
    </div>

    <div class="scbody" id="depBody" x-data="{select: false}">
        <small>CHOOSE COIN TO DEPOSIT</small><br>
        <div @click="select = !select"> 
            <div class="box_eth" :class="select ? 'box_eth_selected' : 'box_eth'">
                <h2>ETH</h2>
                <small>Ethereum</small>
            </div>
        </div>
        <div class="warns">
            <span>
                <svg style="flex-shrink:0;margin-top:1px" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#00d4aa" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
            </span>
            <span>
                Deposits increase your daily growth rate. Every $100 deposited adds +0.1%/day to your rate, up to 2.5%/day.
            </span>
        </div>
        <button>
            Continue → 
        </button>
    </div>
</div>
<script>
   
</script>