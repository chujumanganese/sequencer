<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="/js/alpine_variable.js"></script>
</head>
<body>
    <div class="padding" x-data="{ page: 'portfolio'}">
        <aside>
            <h3>NexVault</h3><br>
            <ul>
                <small>Explore</small>
                <li @click="page = 'portfolio'">
                    <span class="aside_icons">
                        <svg viewBox="0 0 24 24" :stroke="page === 'portfolio' ? 'white' : 'darkgrey'" :fill="page === 'portfolio' ? 'white' : black">
                            <rect x="3" y="3" width="7" height="7" rx="1" />
                            <rect x="14" y="3" width="7" height="7" rx="1" />
                            <rect x="3" y="14" width="7" height="7" rx="1" />
                            <rect x="14" y="14" width="7" height="7" rx="1" />
                        </svg>
                    </span>
                    <span :class="page === 'portfolio' ? 'active' : 'aside_icons'">Portfolio</span>
                </li>
                <hr style="border-color: grey;"><br>
                <small>General</small>
                <li @click="page = 'withdrawal'">
                    <span class="aside_icons"> 
                        <svg viewBox="0 0 24 24" :stroke="page === 'withdrawal' ? 'white' : 'darkgrey'" :fill="page === 'withdrawal' ? 'white' : black">
                            <circle cx="12" cy="12" r="10" :fill="page === 'withdrawal' ? 'white' : black" />
                            <line x1="12" y1="8" x2="12" y2="12" stroke="green" stroke-width="5" />
                            <line x1="12" y1="16" x2="12.01" y2="16" stroke="green" />
                        </svg>
                    </span>
                    <span :class="page === 'withdrawal' ? 'active' : 'aside_icons'">Withdraw</span>
                </li>
                <li @click="page = 'trade'">
                    <span class="aside_icons">
                        <svg viewBox="0 0 24 24" :stroke="page === 'trade' ? 'white' : 'darkgrey'" :fill="page === 'trade' ? 'white' : black">
                            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
                            <polyline points="16 7 22 7 22 13" />
                        </svg>
                    </span>
                    <span :class="page === 'trade' ? 'active' : 'aside_icons'">Trade</span>
                </li>
                <li @click="page = 'account'">
                    <span class="aside_icons">
                        <svg viewBox="0 0 24 24" :stroke="page === 'account' ? 'white' : 'darkgrey'" :fill="page === 'account' ? 'white' : black">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </span>
                    <span :class="page === 'account' ? 'active' : 'aside_icons'">Account</span>
                </li>
            </ul>
        </aside>
        <div class="covering">
            <nav>
                <div class="top">
                    <small>welcome back</small>
                    <h5>JOHN</h5>
                </div>
                <ul>
                    <li @click="page = 'deposit'">
                        <small>Deposit</small>
                    </li>
                    <li @click="page = 'withdrawal'"><small>Withdraw</small></li>
                    <li @click="page = 'crypto'"><small>Buy Crypto</small></li>
                </ul>
                <small style="display: inline-block; margin-inline: 1em;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <small>
                </small style="display: inline-block; margin-inline: 1em;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                </small>
            </nav>
            <div x-show="page === 'trade'" >
                {{> trade }}
            </div>
            <div x-show="page === 'deposit'">
                {{> deposit }}
            </div>
            <div x-show="page === 'withdrawal'">
                {{> withdrawal }}
            </div>
            <div x-show="page === 'account'">
                {{> account }}
            </div>
            <div x-show="page === 'crypto'">
                {{> buy_crypto }}
            </div>
            <main x-show="page === 'portfolio'">
                <div x-data="{show_alert: true}" x-init="setTimeout(()=>{ show_alert = false },5000)">
                    <div class="alert" x-show="show_alert" x-transition.duration.1000ms>
                        <span class="one">🎉</span>
                        <p>
                            <span class="h_alert">Welcome Bonus Activated!</span>
                            <br><small>You have received a</small> $1,000 
                            <small>welcome bonus. It grows daily — reach</small> $10,000 
                            <small>to unlock withdrawal.</small>
                        </p>
                    </div>
                </div>
                <section>
                    <small>TOTAL PORTFOLIO VALUE</small>
                    <h3>$ 1,030.38</h3>
                    <p><span class="odd_p">+0.50%</span> +$5.15 today</p>
                    <div class="card">
                        <div class="lower">
                            <small>progress to withdrawal</small>
                            <small>1000</small>
                        </div>
                        <div class="progress_bar">
                            <div></div>
                        </div>
                        <div class="lower">
                            <small>$1,030</small>
                            <small>Goal: $10,000</small>
                        </div>
                        <div class="verify">
                            <p>Identity verification pending</p>
                            <p>Verify →</p>
                        </div>
                    </div>
                </section>
                <div class="boxes">
                    <ul>
                        <li><small>Daily Rate</small><br> 0.50%</li>
                        <li><small>Days Active</small><br>5</li>
                        <li><small>Total Earned</small><br><span class="h_alert">$0.00</span></li>
                    </ul>
                </div>
                <div class="footer" @click="page = 'deposit'">
                    <div class="first_element">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00d4aa" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <polyline points="19 12 12 5 5 12"></polyline>
                        </svg>
                    </div>
                    <div class="foot">
                        <h4>Boost your growth</h4>
                        <small>Deposit crypto to increase your daily growth rate and reach $10,000 faster.</small>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="/js/withdrawal.js"></script>
</body>
</html>